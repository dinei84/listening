# Copie para .env e preencha. O .env NÃO é versionado (ver .gitignore).
# Variável já exportada no shell vence o arquivo — o .env nunca sobrescreve.

# Ajudante de texto (OS-038): números por extenso e abreviações, antes da síntese.
LLM_API_KEY=

# Preparação prosódica (OS-054), desligada por padrão em config.yaml.
PROSODY_API_KEY=

# Speaker da OpenAI (OS-055). Só é usado com `speaker: openai` no config.yaml.
OPENAI_API_KEY=
# Opcionais:
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=nova
# OPENAI_INSTRUCTIONS=Narre como um audiolivro em português do Brasil, ritmo pausado e dicção clara. Faça a entonação subir nas perguntas e dê ênfase real nas exclamações.
